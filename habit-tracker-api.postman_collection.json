    {
      "name": "List habits",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/habits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "habits"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create habit",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/habits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "habits"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Drink water\",\n  \"frequency\": \"daily\",\n  \"targetCount\": 8,\n  \"tagIds\": [\n    \"{{tagId}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json()",
              "",
              "if (body.habit) {",
              "  pm.collectionVariables.set('habitId', body.habit.id)",
              "}"
            ]
          }
        }
      ]
    },
